<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense Analysis</title>
    <!-- Include Chart.js library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 20px;
        }
        h1 {
            color: #333;
        }
        canvas {
            max-width: 600px;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <h1 id="food">Food: <%= foodamount %></h1>
    <h1 id="bill">Bills: <%= billamount %></h1>
    <h1 id="fee">College Fees: <%= feeamount %></h1>
    <h1 id="access">Accessories: <%= accessamount %></h1>
    <h1 id="others">Others: <%= otheramount %></h1>
    <canvas id="mychart"></canvas>
    
    <!-- Include your JavaScript code here -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const getElementText = (id) => parseFloat(document.getElementById(id).textContent.replace(/[^0-9.]/g, '')) || 0;

            const foodAmount = getElementText('food');
            const billsAmount = getElementText('bill');
            const accessoriesAmount = getElementText('access');
            const clgFeesAmount = getElementText('fee');
            const othersAmount = getElementText('others');

            const totalExpenses = foodAmount + billsAmount + accessoriesAmount + clgFeesAmount + othersAmount;

            const foodShare = (foodAmount / totalExpenses) * 100;
            const billsShare = (billsAmount / totalExpenses) * 100;
            const accessoriesShare = (accessoriesAmount / totalExpenses) * 100;
            const clgFeesShare = (clgFeesAmount / totalExpenses) * 100;
            const othershare = (othersAmount / totalExpenses) * 100;

            const labels = ['Food', 'Bills', 'Accessories', 'College Fees', 'Others'];
            const itemdata = [foodShare, billsShare, accessoriesShare, clgFeesShare, othershare];

            const data = {
                labels: labels,
                datasets: [{
                    data: itemdata,
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4CAF50', '#428af5'],
                }]
            };

            const config = {
                type: 'pie',
                data: data
            };

            const ctx = document.getElementById('mychart').getContext('2d');
            new Chart(ctx, config);
        });
    </script>
</body>
</html>
